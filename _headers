# Seguridad — aplica a todo
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# HTML: sin caché (Google siempre ve la versión actual)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Service worker: nunca cacheado por el navegador
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Manifest: sin caché
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

# OG image: 1 día
/og-image.png
  Cache-Control: public, max-age=86400

# Assets estáticos: caché larga (inmutable)
/icon-192.png
  Cache-Control: public, max-age=31536000, immutable

/icon-512.png
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=31536000, immutable
